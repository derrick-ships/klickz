# Browser-safe Supabase configuration only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service role key for background Inngest workers & unlisted /reports/:slug delivery.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical public HTTPS origin. HTTP loopback is allowed for local development.
APP_ORIGIN=http://localhost:3000
# Generate 32 random bytes as 64 hex characters; store in encrypted server env.
# Required for per-user provider encryption and OAuth tokens. Never expose publicly.
STUDIO_ENCRYPTION_KEY=
AI_ENABLED=true
# invite_only (default: owner + studio_invites table) or public (open sign-up)
ACCESS_MODE=invite_only
OWNER_GATE=true
# Background orchestration (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Automatic PDF + Markdown email delivery (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=OpenPikzels Reports <reports@openpikzels.com>
# Development preview only. If true, existing owner keys can be used ONLY after
# app_web_access() confirms that exact account. Public users NEVER inherit them.
OWNER_PROVIDER_KEYS=false
OPENAI_API_KEY=
JEV_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
JEV_MODEL=jev-latest
GOOGLE_TEXT_MODEL=gemini-3.5-flash-lite
# Latest Anthropic Opus id from https://docs.anthropic.com/en/docs/about-claude/models/overview (checked 2026-11-10). Overrides the built-in default.
ANTHROPIC_VISION_MODEL=
