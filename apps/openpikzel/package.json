{
  "name": "openpikzel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-widget.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test --grep-invert @performance",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "perf:lighthouse": "node scripts/lighthouse-gate.mjs",
    "perf:lab": "playwright test tests/browser/performance.spec.ts --workers=1",
    "perf:check": "python scripts/check_perf_budget.py evidence/performance-lab.json",
    "verify:release": "npm run verify && npm run perf:lab && npm run perf:check && npm run perf:lighthouse"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.51.1",
    "@types/node": "24.0.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "esbuild": "0.28.2",
    "puppeteer-core": "25.16.0",
    "supabase": "2.79.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "web-vitals": "6.2.3"
  }
}
